---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, "") }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const date = new Intl.DateTimeFormat("es-ES", { dateStyle: "long" }).format(entry.data.pubDate);
---

<BaseLayout title={`${entry.data.title} — Eduardo Parra`} description={entry.data.description}>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <a href="/notas" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Todas las notas</a>
    <article class="mt-6">
      {entry.data.image && <img src={entry.data.image} alt="" width="1200" height="630" fetchpriority="high" class="mb-8 aspect-[16/9] w-full rounded-2xl object-cover" />}
      <header class="border-b border-[#e5e4dc] pb-7 dark:border-[#27342b]">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#2d4b3b] dark:text-[#8bd4a7]">Notas personales</p>
        <h1 class="mt-3 font-serif text-4xl font-bold leading-tight tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">{entry.data.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{entry.data.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-[#636c65] dark:text-[#919c93]">
          <time datetime={entry.data.pubDate.toISOString()}>{date}</time>
          {entry.data.updatedDate && <span>· Actualizada el {new Intl.DateTimeFormat("es-ES", { dateStyle: "long" }).format(entry.data.updatedDate)}</span>}
        </div>
        {entry.data.tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{entry.data.tags.map((tag) => <li class="rounded-full bg-[#edf0e7] px-3 py-1 text-xs font-medium text-[#2d4b3b] dark:bg-[#202e25] dark:text-[#8bd4a7]">{tag}</li>)}</ul>}
      </header>
      {headings.length > 1 && <nav aria-label="Contenido del artículo" class="my-8 rounded-xl border border-[#dedcd2] bg-white/60 p-5 dark:border-[#27342b] dark:bg-[#151d17]"><h2 class="font-semibold">En esta nota</h2><ul class="mt-3 list-inside list-disc space-y-2 text-sm">{headings.map((heading) => <li><a class="text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
      <div class="note-content mt-8 max-w-none">
        <Content />
      </div>
    </article>
    <footer class="mt-12 border-t border-[#e5e4dc] pt-6 dark:border-[#27342b]"><a href="/notas" class="font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver al archivo de notas</a></footer>
  </main>
</BaseLayout>
