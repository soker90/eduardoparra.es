---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BookCard from "../../components/BookCard.astro";
import { books, formatBookDate, formatPublishedYear, slugifyBookTitle } from "../../data/books";
import "../../styles/global.css";

export function getStaticPaths() {
  return books.map((book) => ({
    params: { id: String(book.issueNumber ?? slugifyBookTitle(book.title)) },
    props: { book },
  }));
}

const { book } = Astro.props;
const year = formatPublishedYear(book.publishedDate);
const synopsis = book.longDescription?.trim() || book.description?.trim();
const metadata = [
  book.publisher ? ["Editorial", book.publisher] : null,
  year ? ["Año de publicación", year] : null,
  book.pageCount && book.pageCount > 0 ? ["Páginas", String(book.pageCount)] : null,
  book.language ? ["Idioma", book.language.toUpperCase()] : null,
  book.isbn13 ? ["ISBN-13", book.isbn13] : book.isbn10 ? ["ISBN", book.isbn10] : null,
  book.startedAt ? ["Empecé a leerlo", formatBookDate(book.startedAt)] : null,
  book.completedAt ? ["Terminé de leerlo", formatBookDate(book.completedAt)] : null,
].filter((item): item is string[] => item !== null);
const rating = book.personalRating && book.personalRating > 0 ? book.personalRating : book.goodreadsRating;
const statusLabel = book.state === "reading" ? "Leyendo" : book.state === "completed" ? "Leído" : "Pendiente";
const otherBooks = books.filter((other) => other.title !== book.title);
const byAuthor = otherBooks.filter((other) => other.authors.some((author) => book.authors.includes(author))).slice(0, 6);
const collections = book.collections ?? [];
const byCollection = collections.length
  ? otherBooks.filter((other) => other.collections?.some((collection) => collections.includes(collection))).slice(0, 6)
  : [];
const externalReviews = book.externalReviews ?? [];
---
<BaseLayout title={`${book.title} — Entre lecturas`} description={synopsis || `Ficha de ${book.title}, de ${book.authors.join(", ")}.`} ogImage={book.image || undefined} ogType="article">
  <SiteHeader />
  <main class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <a href="/libros" class="inline-flex text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a Entre lecturas</a>
    <article class="mt-6 overflow-hidden rounded-3xl border border-[#dedcd2] bg-white/80 dark:border-[#27342b] dark:bg-[#151d17]">
      <div class="grid gap-8 p-5 sm:p-8 md:grid-cols-[minmax(0,260px)_1fr] md:gap-10">
        <div class="mx-auto w-full max-w-[260px] self-start">
          {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="520" height="780" decoding="async" fetchpriority="high" class="block h-auto w-full rounded-2xl object-contain shadow-sm" onerror="this.hidden=true; this.nextElementSibling.hidden=false" /> : null}
          <div hidden={Boolean(book.image)} class="flex aspect-[2/3] w-full items-center justify-center rounded-2xl border border-dashed border-[#c8cec4] bg-[#f5f4ed] p-5 text-center text-sm text-[#636c65] dark:border-[#35453a] dark:bg-[#202a22] dark:text-[#a8b2aa]">
            <span><span class="mb-3 block text-4xl" aria-hidden="true">▤</span>Portada no disponible</span>
          </div>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#2d4b3b] dark:text-[#6ec490]">Entre lecturas · Ficha del libro</p>
          <h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-4xl">{book.title}</h1>
          <p class="mt-3 text-lg text-[#555f58] dark:text-[#a8b2aa]">{book.authors.join(", ")}</p>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-[#edf0e7] px-3 py-1 text-xs font-semibold text-[#405548] dark:bg-[#26372c] dark:text-[#b7d9c1]">{statusLabel}</span>
            {book.categories?.slice(0, 8).map((category) => <span class="rounded-full border border-[#dedcd2] px-3 py-1 text-xs text-[#555f58] dark:border-[#35453a] dark:text-[#a8b2aa]">{category}</span>)}
          </div>
          {rating && rating > 0 ? <p class="mt-5 text-sm font-semibold text-[#80591d] dark:text-[#f2cf82]">★ {rating.toLocaleString("es-ES", { maximumFractionDigits: 1 })}/5 <span class="font-normal text-[#777] dark:text-[#a9b3aa]">· Goodreads</span></p> : null}
          {book.progressPercent !== undefined && book.state === "reading" ? <div class="mt-5 max-w-sm"><div class="mb-1 flex justify-between text-xs text-[#636c65] dark:text-[#95a097]"><span>Progreso de lectura</span><span>{book.progressPercent}%</span></div><div class="h-2 overflow-hidden rounded-full bg-[#dfe4da] dark:bg-[#2b3930]"><div class="h-full rounded-full bg-[#398357]" style={`width: ${Math.min(100, Math.max(0, book.progressPercent))}%`}></div></div></div> : null}
          {synopsis ? <section class="mt-7"><h2 class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Sinopsis</h2><p class="mt-2 whitespace-pre-line text-sm leading-7 text-[#46534a] dark:text-[#bac5bd]">{synopsis}</p></section> : <section class="mt-7 rounded-xl bg-[#f5f4ed] p-4 text-sm text-[#636c65] dark:bg-[#202a22] dark:text-[#a8b2aa]">Todavía no hay una sinopsis disponible para esta edición.</section>}
          {metadata.length ? <section class="mt-7"><h2 class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Datos del libro</h2><dl class="mt-3 grid gap-3 sm:grid-cols-2">{metadata.map(([label, value]) => <div class="rounded-xl bg-[#f5f4ed] p-3 dark:bg-[#202a22]"><dt class="text-xs text-[#737b75] dark:text-[#95a097]">{label}</dt><dd class="mt-1 break-words text-sm font-medium text-[#17231e] dark:text-[#f2f6f3]">{value}</dd></div>)}</dl></section> : null}
          {collections.length || book.series ? <section class="mt-7"><h2 class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Colección y serie</h2><div class="mt-3 flex flex-wrap gap-2">{book.series ? <span class="rounded-full bg-[#edf0e7] px-3 py-1.5 text-sm text-[#405548] dark:bg-[#26372c] dark:text-[#b7d9c1]">{book.series}</span> : null}{collections.map((collection) => <span class="rounded-full bg-[#edf0e7] px-3 py-1.5 text-sm text-[#405548] dark:bg-[#26372c] dark:text-[#b7d9c1]">{collection}</span>)}</div></section> : null}
        </div>
      </div>
    </article>

    {externalReviews.length > 0 && <section class="mt-10" aria-labelledby="external-reviews-title">
      <div class="mb-4"><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Opiniones externas</p><h2 id="external-reviews-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Reseñas del libro</h2></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{externalReviews.map((review) => <a href={review.url} target="_blank" rel="noopener noreferrer" class="group flex min-h-36 flex-col rounded-2xl border border-[#dedcd2] bg-white/80 p-5 transition hover:-translate-y-0.5 hover:border-[#9eaf9f] hover:shadow-sm dark:border-[#27342b] dark:bg-[#151d17] dark:hover:border-[#496b53]"><span class="text-xs font-bold uppercase tracking-wider text-[#52735d] dark:text-[#8bd4a7]">{review.source}</span><span class="mt-2 font-serif text-lg font-bold text-[#17231e] group-hover:underline dark:text-[#f2f6f3]">{review.title || `Reseña en ${review.source}`}</span>{review.description ? <span class="mt-2 text-sm leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{review.description}</span> : null}<span class="mt-auto pt-4 text-sm font-semibold text-[#2d4b3b] dark:text-[#8bd4a7]">Leer reseña ↗</span></a>)}</div>
    </section>}

    {byAuthor.length > 0 && <section class="mt-10" aria-labelledby="same-author-title">
      <div class="mb-4"><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Más lecturas</p><h2 id="same-author-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Otros libros del autor</h2></div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">{byAuthor.map((related) => <BookCard book={related} />)}</div>
    </section>}

    {byCollection.length > 0 && <section class="mt-10" aria-labelledby="same-collection-title">
      <div class="mb-4"><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Continúa leyendo</p><h2 id="same-collection-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">De la misma colección</h2></div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">{byCollection.map((related) => <BookCard book={related} />)}</div>
    </section>}

    <div class="mt-10"><a href="/libros" class="inline-flex items-center rounded-full border border-[#d5d9d0] px-4 py-2.5 text-sm font-semibold text-[#2d4b3b] hover:bg-[#edf0e7] dark:border-[#35453a] dark:text-[#8bd4a7] dark:hover:bg-[#202a22]">← Todas mis lecturas</a></div>
  </main>
</BaseLayout>
