---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { books, bookIssueUrl, formatBookDate, formatPublishedYear, slugifyBookTitle } from "../../data/books";
import "../../styles/global.css";

export function getStaticPaths() {
  return books.map((book) => ({
    params: { id: String(book.issueNumber ?? slugifyBookTitle(book.title)) },
    props: { book },
  }));
}

const { book } = Astro.props;
const year = formatPublishedYear(book.publishedDate);
const metadata = [
  book.publisher ? ["Editorial", book.publisher] : null,
  year ? ["Año de publicación", year] : null,
  book.pageCount && book.pageCount > 0 ? ["Páginas", String(book.pageCount)] : null,
  book.language ? ["Idioma", book.language.toUpperCase()] : null,
  book.isbn13 ? ["ISBN-13", book.isbn13] : book.isbn10 ? ["ISBN", book.isbn10] : null,
  book.startedAt ? ["Empecé a leerlo", formatBookDate(book.startedAt)] : null,
  book.completedAt ? ["Terminé de leerlo", formatBookDate(book.completedAt)] : null,
].filter((item): item is string[] => item !== null);
const rating = book.personalRating && book.personalRating > 0 ? book.personalRating : book.goodreadsRating;
const statusLabel = book.state === "reading" ? "Leyendo" : book.state === "completed" ? "Leído" : "Pendiente";
---
<BaseLayout title={`${book.title} — Entre lecturas`} description={book.description || `Ficha de ${book.title}, de ${book.authors.join(", ")}.`} ogImage={book.image || undefined} ogType="article">
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <a href="/libros" class="inline-flex text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a Entre lecturas</a>
    <article class="mt-6 overflow-hidden rounded-3xl border border-[#dedcd2] bg-white/80 dark:border-[#27342b] dark:bg-[#151d17]">
      <div class="grid gap-8 p-5 sm:p-8 md:grid-cols-[minmax(180px,280px)_1fr] md:gap-10">
        <div class="mx-auto w-full max-w-[280px] overflow-hidden rounded-2xl bg-[#e4e7df] dark:bg-[#202a22]">
          {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="560" height="840" decoding="async" class="aspect-[2/3] w-full object-cover" /> : <div class="flex aspect-[2/3] items-center justify-center p-4 text-center text-sm text-[#636c65]">Portada no disponible</div>}
        </div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#2d4b3b] dark:text-[#6ec490]">Entre lecturas · Ficha del libro</p>
          <h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-4xl">{book.title}</h1>
          <p class="mt-3 text-lg text-[#555f58] dark:text-[#a8b2aa]">{book.authors.join(", ")}</p>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-[#edf0e7] px-3 py-1 text-xs font-semibold text-[#405548] dark:bg-[#26372c] dark:text-[#b7d9c1]">{statusLabel}</span>
            {book.categories?.map((category) => <span class="rounded-full border border-[#dedcd2] px-3 py-1 text-xs text-[#555f58] dark:border-[#35453a] dark:text-[#a8b2aa]">{category}</span>)}
          </div>
          {rating && rating > 0 ? <p class="mt-5 text-sm font-semibold text-[#80591d] dark:text-[#f2cf82]">★ {rating.toLocaleString("es-ES", { maximumFractionDigits: 1 })}/5 <span class="font-normal text-[#777] dark:text-[#a9b3aa]">· Goodreads</span></p> : null}
          {book.progressPercent !== undefined && book.state === "reading" ? <div class="mt-5 max-w-sm"><div class="mb-1 flex justify-between text-xs text-[#636c65] dark:text-[#95a097]"><span>Progreso de lectura</span><span>{book.progressPercent}%</span></div><div class="h-2 overflow-hidden rounded-full bg-[#dfe4da] dark:bg-[#2b3930]"><div class="h-full rounded-full bg-[#398357]" style={`width: ${Math.min(100, Math.max(0, book.progressPercent))}%`}></div></div></div> : null}
          {book.description ? <section class="mt-7"><h2 class="font-serif text-xl font-bold">Sinopsis</h2><p class="mt-2 whitespace-pre-line text-sm leading-7 text-[#46534a] dark:text-[#bac5bd]">{book.description}</p></section> : null}
          {metadata.length ? <section class="mt-7"><h2 class="font-serif text-xl font-bold">Datos del libro</h2><dl class="mt-3 grid gap-3 sm:grid-cols-2">{metadata.map(([label, value]) => <div class="rounded-xl bg-[#f5f4ed] p-3 dark:bg-[#202a22]"><dt class="text-xs text-[#737b75] dark:text-[#95a097]">{label}</dt><dd class="mt-1 break-words text-sm font-medium">{value}</dd></div>)}</dl></section> : null}
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={bookIssueUrl(book)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-[#2d4b3b] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#203b2d]">Ver registro del libro en GitHub ↗</a>
            <a href="/libros" class="inline-flex items-center rounded-full border border-[#d5d9d0] px-4 py-2.5 text-sm font-semibold hover:bg-[#edf0e7] dark:border-[#35453a] dark:hover:bg-[#202a22]">Todas mis lecturas</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
