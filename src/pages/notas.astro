---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

const notes = [
  {
    title: "Issue Link: base de enlaces y recursos en Markdown",
    date: "10 oct 2026",
    image: "/images/notes/entorno-desarrollo.webp",
    description: "Una herramienta para organizar enlaces e ideas técnicas directamente en archivos Markdown.",
    href: "https://link.eduardoparra.es",
    kind: "Herramienta",
  },
  {
    title: "Bot de Telegram para el precio de la gasolina",
    date: "28 sept 2026",
    image: "/images/notes/ideas-proyectos.webp",
    description: "Proyecto que avisa cuando cambian los precios de las estaciones de servicio seleccionadas.",
    href: "https://github.com/soker90/precio-gasolina",
    kind: "Automatización",
  },
  {
    title: "Mantenimiento automatizado de paquetes AUR",
    date: "15 sept 2026",
    image: "/images/notes/paquetes-aur.webp",
    description: "Notas y desarrollo de una GitHub Action para automatizar actualizaciones de paquetes de Arch Linux.",
    href: "https://github.com/soker90/aur-maintainer",
    kind: "Código abierto",
  },
];
---

<BaseLayout
  title="Notas y apuntes — Eduardo Parra"
  description="Notas, herramientas, automatizaciones y proyectos que voy desarrollando y descubriendo."
>
  <a
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white dark:focus:bg-[#1a241e] focus:text-[#17231e] dark:focus:text-white focus:rounded-md focus:shadow-md focus:ring-2 focus:ring-[#2d4b3b]"
    href="#contenido"
  >Saltar al contenido</a>
  <SiteHeader />

  <main id="contenido" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16">
    <header class="border-b border-[#e5e4dc] dark:border-[#222b25] pb-8 mb-8">
      <a href="/#notas" class="inline-flex items-center gap-2 text-xs font-semibold text-[#2d4b3b] dark:text-[#6ec490] hover:underline mb-5">← Volver a la portada</a>
      <p class="text-[11px] sm:text-xs font-bold tracking-widest text-[#2c4b3a] dark:text-[#6ec490] uppercase mb-2">CUADERNO DIGITAL</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3]">Notas y apuntes</h1>
      <p class="text-base sm:text-lg text-[#555f58] dark:text-[#9ea9a1] leading-relaxed mt-4 max-w-2xl">
        Herramientas, automatizaciones y proyectos que estoy construyendo o que me sirven para aprender. Cada entrada enlaza al recurso original.
      </p>
    </header>

    <section aria-label="Listado de notas" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {notes.map((note) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-[#dedcd2] dark:border-[#27342b] bg-white/70 dark:bg-[#151d17] transition-colors hover:bg-white dark:hover:bg-[#1a241e]">
          <a href={note.href} target="_blank" rel="noopener noreferrer" class="block aspect-[16/9] overflow-hidden bg-[#e4e7df] dark:bg-[#1e2821]" aria-label={`Abrir recurso: ${note.title} (se abre en otra pestaña)`}>
            <img src={note.image} alt="" loading="lazy" decoding="async" width="640" height="360" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
          </a>
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full bg-[#edf0e7] dark:bg-[#202e25] px-2.5 py-1 text-[10px] font-semibold text-[#2d4b3b] dark:text-[#8bd4a7]">{note.kind}</span>
              <time class="text-xs text-[#636c65] dark:text-[#919c93]">{note.date}</time>
            </div>
            <h2 class="mt-3 font-serif text-xl font-bold leading-snug text-[#17231e] dark:text-[#f0f5f1]">{note.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{note.description}</p>
            <a href={note.href} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#2d4b3b] dark:text-[#8bd4a7] hover:underline">
              Abrir recurso <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
