---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = (await getCollection("notes", ({ data }) => !data.draft))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());


const formatDate = (date: Date) => new Intl.DateTimeFormat("es-ES", { dateStyle: "medium" }).format(date);
---

<BaseLayout title="Blog — Eduardo Parra" description="Artículos y tutoriales sobre tecnología, programación, Linux y proyectos.">
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-[#17231e] focus:shadow-md focus:ring-2 focus:ring-[#2d4b3b] dark:focus:bg-[#1a241e] dark:focus:text-white">
    Saltar al contenido
  </a>
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="mb-10 border-b border-[#e5e4dc] pb-8 dark:border-[#222b25]">
      <a href="/#blog" class="mb-5 inline-flex items-center gap-2 text-xs font-semibold text-[#2d4b3b] hover:underline dark:text-[#6ec490]">← Volver a la portada</a>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-widest text-[#2c4b3a] dark:text-[#6ec490]">BLOG PERSONAL</p>
      <h1 class="font-serif text-4xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">Blog</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#555f58] dark:text-[#9ea9a1] sm:text-lg">Artículos y tutoriales sobre tecnología, programación y proyectos.</p>
      <a href="/rss.xml" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]"> <span aria-hidden="true">◔</span> Suscribirse por RSS</a>
    </header>

    <section aria-labelledby="articles-title" class="mb-14">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Escrito por mí</p><h2 id="articles-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Todos los artículos</h2></div>
        <span class="text-sm text-[#636c65] dark:text-[#919c93]">{posts.length} {posts.length === 1 ? "entrada" : "entradas"}</span>
      </div>
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group flex flex-col overflow-hidden rounded-2xl border border-[#dedcd2] bg-white/70 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#b8c7b8] hover:bg-white hover:shadow-md dark:border-[#27342b] dark:bg-[#151d17] dark:hover:border-[#3e5645] dark:hover:bg-[#1a241e]">
              <a href={`/blog/${post.id.replace(/\.md$/, "")}`} class="block aspect-[16/9] overflow-hidden bg-[#e4e7df] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[#2d4b3b] dark:bg-[#1e2821] dark:focus-visible:outline-[#52a578]" aria-label={`Leer: ${post.data.title}`}>
                {post.data.image ? <img src={post.data.image} alt="" width="640" height="360" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" /> : <div class="flex aspect-[16/9] items-center justify-center bg-[#edf0e7] p-6 font-serif text-2xl font-semibold text-[#2d4b3b] dark:bg-[#202e25] dark:text-[#8bd4a7]">Blog</div>}
              </a>
              <div class="flex flex-1 flex-col p-5">
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-[#636c65] dark:text-[#919c93]">{formatDate(post.data.pubDate)}</time>
                <h3 class="mt-2 font-serif text-xl font-bold leading-snug text-[#17231e] dark:text-[#f0f5f1]">{post.data.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{post.data.description}</p>
                {post.data.tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{post.data.tags.map((tag) => <li class="rounded-full bg-[#edf0e7] px-2.5 py-1 text-xs text-[#2d4b3b] dark:bg-[#202e25] dark:text-[#8bd4a7]">{tag}</li>)}</ul>}
                <a href={`/blog/${post.id.replace(/\.md$/, "")}`} class="mt-5 text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">Leer artículo →</a>
              </div>
            </article>
          ))}
        </div>
      ) : <p class="rounded-xl border border-dashed border-[#dedcd2] p-6 text-sm text-[#555f58] dark:border-[#27342b] dark:text-[#a8b2aa]">Todavía no hay artículos publicados. Puedes preparar el primero en <code>src/content/notes/</code>; las entradas marcadas como borrador no aparecen aquí.</p>}
    </section>


  </main>
</BaseLayout>
