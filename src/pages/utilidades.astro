---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getIssueLinkUtilities } from "../data/issue-link";

const utilityProjects = await getIssueLinkUtilities();
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/global.css";
---
<BaseLayout title="Utilidades — Eduardo Parra" description="Enlaces y recursos guardados en Issue Link, actualizados automáticamente.">
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-[#17231e] focus:shadow-md focus:ring-2 focus:ring-[#2d4b3b] dark:focus:bg-[#1a241e] dark:focus:text-white">
    Saltar al contenido
  </a>
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="mb-10 border-b border-[#e5e4dc] pb-8 dark:border-[#222b25]">
      <a href="/" class="mb-5 inline-flex text-xs font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a la portada</a>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#2c4b3a] dark:text-[#6ec490]">HERRAMIENTAS PRÁCTICAS</p>
      <h1 class="font-serif text-4xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">Utilidades</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#555f58] dark:text-[#9ea9a1] sm:text-lg">Enlaces que guardo en Issue Link. Se muestran aquí automáticamente, sin importar el tipo de recurso.</p>
    </header>
    <section aria-labelledby="tools-title">
      <div class="mb-5 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Colección</p><h2 id="tools-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Últimos recursos de Issue Link</h2></div><span class="text-sm text-[#636c65] dark:text-[#919c93]">{utilityProjects.length} recursos</span></div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">{utilityProjects.map((project) => <ProjectCard project={project} />)}</div>
    </section>
    <p class="mt-8 text-sm text-[#636c65] dark:text-[#919c93]">¿Buscas mis desarrollos? <a href="/proyectos" class="font-semibold text-[#2d4b3b] underline dark:text-[#8bd4a7]">Explora mis proyectos →</a></p>
  </main>
</BaseLayout>