---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BookShelf from "../components/BookShelf.astro";
import { projects } from "../data/projects";
import "../styles/global.css";
---
<BaseLayout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <SiteHeader />
  <main id="contenido">
    <section class="hero container" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Programador y creador de proyectos</p>
        <h1 id="hero-title">Construyendo herramientas que hacen la vida un poco más fácil.</h1>
        <p class="hero-description">Aplicaciones, webs, recetas, utilidades y notas desde La Mancha. Linux, tecnología, buena comida y libros.</p>
        <div class="hero-actions"><a class="button button-primary" href="#proyectos">Ver mis proyectos <span aria-hidden="true">↗</span></a><a class="button" href="#sobre-mi">Sobre mí</a></div>
        <div class="hero-links" aria-label="Secciones de la web">
          <a href="#proyectos"><span class="quick-icon" aria-hidden="true">⌘</span><span><strong>Proyectos</strong><small>Aplicaciones y webs</small></span></a>
          <a href="#recetas"><span class="quick-icon" aria-hidden="true">♨</span><span><strong>Recetas</strong><small>Cocina del día a día</small></span></a>
          <a href="#utilidades"><span class="quick-icon" aria-hidden="true">↗</span><span><strong>Utilidades</strong><small>Herramientas y recursos</small></span></a>
          <a href="#notas"><span class="quick-icon" aria-hidden="true">▤</span><span><strong>Notas</strong><small>Ideas y aprendizajes</small></span></a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src="/images/hero-eduardo-parra-sanderson-migas-uvas.avif"
          alt="Escritorio junto a una ventana con portátil Arch Linux, taza con Tux, libros de Brandon Sanderson y un cuenco de migas de pastor con uvas blancas"
          width="2008"
          height="783"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section class="section container" id="proyectos" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Proyectos destacados</h2><a class="section-link" href="https://github.com/soker90?tab=repositories" target="_blank" rel="noreferrer">Explorar GitHub ↗</a></div>
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </section>

    <section class="section container content-columns" aria-label="Contenido reciente">
      <article class="content-panel" id="recetas"><div class="mini-heading"><span class="section-symbol" aria-hidden="true">♨</span><h2>Últimas recetas</h2></div><p class="muted">Cocina casera, ideas para cada día y algún capricho.</p><a class="text-link" href="https://recetas.eduardoparra.es">Visitar Cocinando con Edu ↗</a><div class="recipe-feature"><span>En la cocina</span><strong>Recetas sin complicaciones, hechas para compartir.</strong><span class="recipe-decoration" aria-hidden="true">✳</span></div></article>
      <article class="content-panel" id="utilidades"><div class="mini-heading"><span class="section-symbol" aria-hidden="true">↗</span><h2>Utilidades</h2></div><ul class="simple-list"><li><span class="round-icon" aria-hidden="true">ϟ</span><span><strong>Precio de la luz</strong><small>Consultar tarifas y datos eléctricos.</small></span><a href="https://github.com/soker90/tarifas-luz" aria-label="Proyecto de tarifas de luz">↗</a></li><li><span class="round-icon" aria-hidden="true">⛽</span><span><strong>Precio de gasolina</strong><small>Datos y seguimiento de precios.</small></span><a href="https://github.com/soker90/precio-gasolina" aria-label="Proyecto de precio de gasolina">↗</a></li><li><span class="round-icon" aria-hidden="true">⌁</span><span><strong>Alertas de alimentos</strong><small>Avisos de seguridad alimentaria.</small></span><a href="https://github.com/soker90/alerta-alimentos-bot" aria-label="Proyecto de alertas de alimentos">↗</a></li></ul></article>
      <article class="content-panel" id="notas"><div class="mini-heading"><span class="section-symbol" aria-hidden="true">▤</span><h2>Notas</h2></div><p class="muted">Ideas, aprendizajes y pequeñas cosas que merece la pena guardar.</p><div class="note-preview"><span class="note-icon" aria-hidden="true">⌘</span><div><strong>Un cuaderno digital en construcción</strong><small>Pronto: notas sobre proyectos, Linux y herramientas que uso.</small></div></div><a class="text-link" href="https://github.com/soker90">También en GitHub ↗</a></article>
    </section>

    <section class="section container"><BookShelf /></section>

    <section class="now-panel container" id="sobre-mi" aria-labelledby="now-title"><div class="now-art" aria-hidden="true"><span>✳</span><span>~/</span><span>☕</span></div><div class="now-copy"><p class="eyebrow">Ahora mismo</p><h2 id="now-title">Programando, cocinando y aprendiendo.</h2><p>Trabajo en mis proyectos, preparo recetas, exploro herramientas de Linux y siempre tengo algún libro en la mesa. Aquí iré compartiendo lo que voy construyendo y lo que voy descubriendo.</p><a class="button button-primary" href="https://github.com/soker90" target="_blank" rel="noreferrer">Ver proyectos en GitHub ↗</a></div><ul class="now-list"><li>Mejorando proyectos personales</li><li>Publicando nuevas recetas</li><li>Automatizando tareas con Linux</li><li>Descubriendo nuevas lecturas</li></ul></section>
  </main>
  <footer class="site-footer container"><a class="wordmark" href="/">Eduardo Parra</a><p>Programador · Proyectos · Recetas · Utilidades · Lecturas</p><div><a href="https://github.com/soker90" target="_blank" rel="noreferrer">GitHub</a><a href="https://www.eduardoparra.es" target="_blank" rel="noreferrer">Archivo de Blogger</a><a href="mailto:hola@eduardoparra.es">Contacto</a></div><small>Hecho con calma, curiosidad y un buen café.</small></footer>
</BaseLayout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: .96fr 1.04fr; align-items: center; gap: 0; min-height: 31rem; padding-block: 1.7rem 1.1rem; }
  .hero-copy { position: relative; z-index: 2; padding-block: 1.2rem 0; }
  .hero h1 { max-width: 13ch; margin: 0; font: 700 clamp(2.7rem, 4.6vw, 4.55rem)/.99 var(--serif); letter-spacing: -.065em; }
  .hero-description { max-width: 37rem; margin: 1rem 0 1.25rem; font: clamp(1.05rem, 1.45vw, 1.25rem)/1.48 var(--serif); color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .hero-actions .button { min-height: 3.1rem; padding-inline: 1.25rem; }
  .hero-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; margin-top: 2.1rem; }
  .hero-links a { display: flex; align-items: center; gap: .6rem; min-width: 0; text-decoration: none; }
  .quick-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex: 0 0 auto; color: var(--green); font-size: 1.8rem; font-weight: 700; }
  .hero-links strong, .hero-links small { display: block; }
  .hero-links strong { font-size: .8rem; }
  .hero-links small { margin-top: .2rem; color: var(--muted); font-size: .68rem; line-height: 1.3; }
  .hero-art { position: relative; align-self: stretch; min-width: 0; min-height: 0; overflow: hidden; background: var(--paper); isolation: isolate; }
  .hero-art img { display: block; width: 100%; height: 100%; min-height: 29rem; object-fit: cover; object-position: center; }
  @media (max-width: 1000px) { .hero-art img { min-height: 25rem; } }
  @media (max-width: 650px) {
    .hero-art { order: -1; min-height: 0; overflow: visible; background: transparent; }
    .hero-art img { width: 100%; height: auto; min-height: 0; aspect-ratio: auto; object-fit: contain; object-position: center; }
  }
  .project-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .content-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding-top: 0; }
  .content-panel { min-width: 0; padding: 1.3rem; border: 1px solid var(--border); border-radius: .8rem; background: #fbfaf5; }
  .mini-heading { display: flex; align-items: center; gap: .6rem; }.mini-heading h2 { margin: 0; font: 700 1.55rem/1.1 var(--serif); letter-spacing: -.04em; }.section-symbol { color: var(--green); font-size: 1.8rem; font-weight: 700; }
  .content-panel > .muted { font-size: .86rem; line-height: 1.55; }
  .text-link { display: inline-block; margin-top: .4rem; font-size: .84rem; font-weight: 700; text-underline-offset: .2em; }
  .recipe-feature { position: relative; display: flex; min-height: 9rem; flex-direction: column; justify-content: flex-end; gap: .5rem; overflow: hidden; margin-top: 1rem; padding: 1rem; border-radius: .6rem; background: linear-gradient(135deg, #314f3d, #9ba47d); color: #fffdf2; }.recipe-feature span { font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }.recipe-feature strong { max-width: 20ch; font: 700 1.25rem/1.2 var(--serif); }.recipe-decoration { position: absolute; right: .6rem; top: .2rem; color: #ffffff42; font-size: 5rem; }
  .simple-list { display: grid; gap: .6rem; margin: 1rem 0 0; padding: 0; list-style: none; }.simple-list li { display: grid; grid-template-columns: 2.4rem 1fr auto; align-items: center; gap: .6rem; padding-block: .55rem; border-bottom: 1px solid var(--border); }.simple-list li:last-child { border-bottom: 0; }.round-icon { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--green-light); color: var(--green); font-size: 1.1rem; }.simple-list strong, .simple-list small { display: block; }.simple-list strong { font-size: .85rem; }.simple-list small { margin-top: .2rem; color: var(--muted); font-size: .73rem; line-height: 1.4; }.simple-list a { font-weight: 700; }
  .note-preview { display: flex; gap: .8rem; margin-top: 1.5rem; padding-block: .9rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }.note-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex: 0 0 auto; border-radius: .5rem; background: var(--green-light); color: var(--green); font-weight: 700; }.note-preview strong, .note-preview small { display: block; }.note-preview strong { font: 700 1rem/1.2 var(--serif); }.note-preview small { margin-top: .4rem; color: var(--muted); font-size: .75rem; line-height: 1.4; }
  .now-panel { display: grid; grid-template-columns: .8fr 1.2fr .85fr; align-items: center; gap: 1.5rem; margin-block: 0 3rem; padding: 1.3rem; border: 1px solid var(--border); border-radius: .9rem; background: #eff0e7; }.now-art { display: flex; min-height: 12rem; flex-direction: column; justify-content: space-between; align-items: center; padding: 1rem; border-radius: .6rem; background: linear-gradient(145deg, #dce4d6, #b8c9b7); color: var(--green); font-size: 2rem; }.now-copy h2 { margin: 0; font: 700 clamp(1.6rem, 2.6vw, 2.25rem)/1.1 var(--serif); letter-spacing: -.04em; }.now-copy > p:not(.eyebrow) { margin: .6rem 0 1rem; color: var(--muted); font-size: .9rem; line-height: 1.55; }.now-list { display: grid; gap: .75rem; margin: 0; padding: 0 0 0 1.2rem; border-left: 1px solid #c8d0c5; list-style: none; }.now-list li { position: relative; font-size: .84rem; }.now-list li::before { position: absolute; left: -1.2rem; color: #38805b; content: "●"; font-size: .8rem; }
  .site-footer { display: grid; grid-template-columns: 1fr auto; gap: .5rem 1rem; align-items: center; padding-block: 1.5rem 2rem; border-top: 1px solid var(--border); }.site-footer .wordmark { font-size: 1.35rem; }.site-footer p { min-height: 0; margin: 0; font-size: .8rem; }.site-footer div { display: flex; gap: 1rem; justify-content: flex-end; grid-column: 2; grid-row: 1; }.site-footer div a { font-size: .8rem; text-underline-offset: .2em; }.site-footer > small { color: var(--muted); font-size: .75rem; grid-column: 1/-1; }
  @media (max-width: 1000px) { .hero { grid-template-columns: 1fr 1fr; gap: .5rem; min-height: 27rem; }.hero h1 { font-size: clamp(2.4rem, 4.7vw, 3.5rem); }.hero-art { min-height: 25rem; }.hero-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }.project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }.content-columns { grid-template-columns: 1fr 1fr; }.content-panel:last-child { grid-column: 1/-1; }.now-panel { grid-template-columns: .6fr 1.4fr; }.now-list { grid-column: 1/-1; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 1rem 0 0; border-left: 0; border-top: 1px solid #c8d0c5; } }
  @media (max-width: 650px) { .hero { grid-template-columns: 1fr; padding-top: 1.2rem; }.hero h1 { max-width: 12ch; font-size: clamp(2.8rem, 12vw, 4rem); }.hero-art { min-height: 21rem; order: -1; }.hero-note { top: .8rem; left: .8rem; }.desk-laptop { top: 4.5rem; }.laptop-screen { height: 9.5rem; }.coffee-mug { bottom: 3rem; }.book-stack { bottom: 3rem; }.hero-links { gap: .8rem .5rem; margin-top: 1.5rem; }.quick-icon { width: 2rem; }.hero-links small { font-size: .68rem; }.project-grid, .content-columns { grid-template-columns: 1fr; }.content-panel:last-child { grid-column: auto; }.now-panel { grid-template-columns: 1fr; }.now-art { min-height: 6rem; flex-direction: row; }.now-list { grid-column: auto; grid-template-columns: 1fr; }.site-footer { grid-template-columns: 1fr; }.site-footer div { grid-column: auto; grid-row: auto; justify-content: flex-start; flex-wrap: wrap; }.site-footer > small { grid-column: auto; } }
</style>
