---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BookShelf from "../components/BookShelf.astro";
import { projects } from "../data/projects";
import { recentResources } from "../data/recent-resources";
import { recipes as latestRecipes } from "../data/recipes";
import "../styles/global.css";

const utilities = [
  {
    title: "Tarifas de la luz",
    description: "Generador de JSON y comparador con las mejores tarifas eléctricas.",
    icon: "lightning",
    href: "https://github.com/soker90/tarifas-luz",
  },
  {
    title: "Alerta Alimentos Bot",
    description: "Bot de Telegram para alertas de seguridad alimentaria de la AESAN.",
    icon: "wrench",
    href: "https://t.me/alertas_aesan",
  },
  {
    title: "AUR Maintainer",
    description: "GitHub Action para mantener paquetes de Arch Linux actualizados.",
    icon: "book",
    href: "https://github.com/soker90/aur-maintainer",
  },
];


---

<BaseLayout>
  <!-- Accessible Skip Link -->
  <a
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-[#17231e] focus:rounded-md focus:shadow-md focus:ring-2 focus:ring-[#2d4b3b]"
    href="#contenido"
  >
    Saltar al contenido
  </a>

  <!-- Header -->
  <SiteHeader />

  <!-- Main Content Container -->
  <main
    id="contenido"
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14 sm:space-y-16 pt-2 pb-12 sm:pb-16"
  >
    <!-- Hero Section -->
    <section class="pt-2 sm:pt-4" id="inicio" aria-labelledby="hero-title">
      <!-- 2 Columns: Copy on Left, Art on Right -->
      <div class="grid grid-cols-1 lg:grid-cols-[0.92fr_1.08fr] items-end gap-8 lg:gap-2">
        <!-- Left Copy -->
        <div class="relative z-10 flex flex-col justify-end pt-2 sm:pt-4">
          <p class="text-[11px] sm:text-xs font-bold tracking-widest text-[#2c4b3a] dark:text-[#6ec490] uppercase mb-3">
            PROGRAMADOR Y CREADOR DE PROYECTOS
          </p>
          <h1
            id="hero-title"
            class="font-serif text-3xl sm:text-5xl lg:text-[3.25rem] font-bold leading-[1.08] tracking-tight text-[#17231e] dark:text-[#f2f6f3]"
          >
            Tecnología, proyectos y otras curiosidades.
          </h1>
          <p class="text-base sm:text-lg text-[#555f58] dark:text-[#9ea9a1] font-normal leading-relaxed mt-4 max-w-xl">
            Aplicaciones, webs, recetas, utilidades y notas desde La Mancha. Linux, tecnología,
            buena comida y libros.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3.5 mt-6 mb-1">
            <a
              class="bg-[#284937] hover:bg-[#1d3527] dark:bg-[#346348] dark:hover:bg-[#284f38] text-white font-medium text-sm px-5 py-3 rounded-lg inline-flex items-center gap-2 shadow-xs transition-colors"
              href="#proyectos"
            >
              <span>Ver mis proyectos</span>
              <span aria-hidden="true">→</span>
            </a>
            <a
              class="bg-white/70 hover:bg-white dark:bg-[#1a231d] dark:hover:bg-[#202c25] border border-[#d6dad1] dark:border-[#2d3a31] text-[#22352b] dark:text-[#e0e7e2] font-medium text-sm px-5 py-3 rounded-lg inline-flex items-center gap-2 transition-colors"
              href="#sobre-mi"
            >
              <svg
                class="w-4 h-4 text-[#4f5c53] dark:text-[#88958c]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
              <span>Sobre mí</span>
            </a>
          </div>
        </div>

        <!-- Right Visual: user photographic composition with Brandon Sanderson and migas con uvas -->
        <div class="relative w-full flex items-end justify-center lg:justify-end overflow-visible">
          <!-- Handwritten Note -->
          <div
            class="absolute -top-3 left-1 sm:left-4 z-20 pointer-events-none transform -rotate-3 select-none"
            aria-hidden="true"
          >
            <p class="font-handwriting text-xl sm:text-2xl text-[#1e3b2b] dark:text-[#8bd4a7] font-semibold leading-tight tracking-wide drop-shadow-xs">
              Ideas, código,
              <br />
              recetas y un poco
              <br />
              de La Mancha.
            </p>
            <div class="w-16 h-0.5 bg-[#1e3b2b]/40 dark:bg-[#8bd4a7]/40 rounded-full mt-1 ml-0.5"></div>
          </div>

          <img
            src="/images/hero-desktop.webp"
            alt="Escritorio con portátil Arch Linux, taza Tux, libros de Tolkien, C.S. Lewis, Brandon Sanderson y cuenco de migas con uvas"
            width="1100"
            height="522"
            fetchpriority="high"
            decoding="async"
            class="block w-full h-auto object-contain object-right max-w-none"
          />
        </div>
      </div>

      <!-- 4 Quick Categories Bar - Spanning ~65% across left-to-center -->
      <div
        class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 items-center gap-6 lg:gap-8 mt-6 sm:mt-7 relative z-20"
        aria-label="Secciones rápidas"
      >
        <!-- Proyectos (~0% left) -->
        <a href="#proyectos" class="group flex items-center gap-3 text-inherit no-underline">
          <span class="text-xl font-bold text-[#2b4c3b] dark:text-[#52a578] font-mono shrink-0 group-hover:scale-110 transition-transform">
            &lt;&gt;
          </span>
          <div>
            <strong class="block text-xs font-bold text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2b4c3b] dark:group-hover:text-[#52a578] transition-colors">
              Proyectos
            </strong>
            <small class="block text-[11px] text-[#69726b] dark:text-[#8d9890] leading-tight mt-0.5">
              Aplicaciones y webs
            </small>
          </div>
        </a>

        <!-- Recetas (~25%) -->
        <a href="#recetas" class="group flex items-center gap-3 text-inherit no-underline">
          <svg
            class="w-5 h-5 text-[#2b4c3b] dark:text-[#52a578] shrink-0 group-hover:scale-110 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z" />
            <line x1="6" y1="17" x2="18" y2="17" />
          </svg>
          <div>
            <strong class="block text-xs font-bold text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2b4c3b] dark:group-hover:text-[#52a578] transition-colors">
              Recetas
            </strong>
            <small class="block text-[11px] text-[#69726b] dark:text-[#8d9890] leading-tight mt-0.5">
              Cocina del día a día
            </small>
          </div>
        </a>

        <!-- Utilidades (~50%) -->
        <a href="#utilidades" class="group flex items-center gap-3 text-inherit no-underline">
          <svg
            class="w-5 h-5 text-[#2b4c3b] dark:text-[#52a578] shrink-0 group-hover:scale-110 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
            />
          </svg>
          <div>
            <strong class="block text-xs font-bold text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2b4c3b] dark:group-hover:text-[#52a578] transition-colors">
              Utilidades
            </strong>
            <small class="block text-[11px] text-[#69726b] dark:text-[#8d9890] leading-tight mt-0.5">
              Herramientas y recursos
            </small>
          </div>
        </a>

        <!-- Notas (~75% on the right side) -->
        <a href="#notas" class="group flex items-center gap-3 text-inherit no-underline">
          <svg
            class="w-5 h-5 text-[#2b4c3b] dark:text-[#52a578] shrink-0 group-hover:scale-110 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <div>
            <strong class="block text-xs font-bold text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2b4c3b] dark:group-hover:text-[#52a578] transition-colors">
              Notas
            </strong>
            <small class="block text-[11px] text-[#69726b] dark:text-[#8d9890] leading-tight mt-0.5">
              Ideas y aprendizajes
            </small>
          </div>
        </a>
      </div>
    </section>

    <!-- Section: Proyectos destacados -->
    <section class="pt-2" id="proyectos" aria-labelledby="projects-title">
      <div class="flex items-baseline justify-between mb-5">
        <h2
          id="projects-title"
          class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1]"
        >
          Proyectos destacados
        </h2>
        <a
          href="/proyectos"
          class="text-xs font-semibold text-[#48534b] dark:text-[#88c99e] hover:text-[#233d2e] dark:hover:text-[#b0e8c2] inline-flex items-center gap-1 transition-colors"
        >
          Ver todos los proyectos <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- Section 3 Columns: Últimas recetas | Últimas utilidades | Notas recientes -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2" aria-label="Contenido reciente">
      <!-- Columna 1: Últimas recetas -->
      <article class="flex flex-col" id="recetas">
        <div class="flex items-center justify-between pb-3 border-b border-[#dedfd5] dark:border-[#27332b]">
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-[#2d4b3b] dark:text-[#52a578]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <h2 class="font-serif text-xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1]">
              Últimas recetas
            </h2>
          </div>
          <a
            href="/recetas"
            class="text-xs font-semibold text-[#48534b] dark:text-[#88c99e] hover:text-[#233d2e] dark:hover:text-[#b0e8c2] inline-flex items-center gap-1"
          >
            Ver todas <span>→</span>
          </a>
        </div>

        <div class="divide-y divide-[#e5e6dd] dark:divide-[#243027]">
          {latestRecipes.map((recipe) => (
            <a
              href={recipe.href}
              target="_blank"
              rel="noreferrer"
              class="group py-3 flex items-center gap-3.5 hover:bg-white/50 dark:hover:bg-[#1a231d]/60 px-1 rounded-lg transition-colors"
            >
              {recipe.image ? <img
                src={recipe.image}
                alt={recipe.title}
                width="62"
                height="38"
                loading="lazy"
                class="w-16 h-10 object-cover rounded-md shrink-0 shadow-2xs border border-[#e2e4dc] dark:border-[#2b3930]"
              /> : <span aria-hidden="true" class="w-16 h-10 rounded-md shrink-0 border border-[#e2e4dc] bg-[#e9ece5] dark:border-[#2b3930] dark:bg-[#202a22] flex items-center justify-center overflow-hidden"><img src="https://recetas.eduardoparra.es/assets/logo.svg" alt="" width="28" height="28" loading="lazy" class="h-7 w-7 object-contain opacity-25 grayscale dark:opacity-30" /></span> }
              <div class="min-w-0 flex-1">
                <h3 class="font-serif font-bold text-xs text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2a4d38] dark:group-hover:text-[#52a578] transition-colors truncate">
                  {recipe.title}
                </h3>
                <p class="text-[11px] text-[#636c65] dark:text-[#919c93] mt-0.5 flex items-center gap-1">
                  <span>{recipe.category}</span>
                  {recipe.date && <><span>·</span><span>{recipe.date}</span></>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </article>

      <!-- Columna 2: Últimas utilidades -->
      <article class="flex flex-col" id="utilidades">
        <div class="flex items-center justify-between pb-3 border-b border-[#dedfd5] dark:border-[#27332b]">
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-[#2d4b3b] dark:text-[#52a578]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
              />
            </svg>
            <h2 class="font-serif text-xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1]">
              Últimas utilidades
            </h2>
          </div>
          <a
            href="/utilidades"
            class="text-xs font-semibold text-[#48534b] dark:text-[#88c99e] hover:text-[#233d2e] dark:hover:text-[#b0e8c2] inline-flex items-center gap-1"
          >
            Ver todas <span>→</span>
          </a>
        </div>

        <div class="divide-y divide-[#e5e6dd] dark:divide-[#243027]">
          {utilities.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="group py-3 flex items-center gap-3.5 hover:bg-white/50 dark:hover:bg-[#1a231d]/60 px-1 rounded-lg transition-colors"
            >
              <span class="w-9 h-9 rounded-full bg-[#dbe5da] dark:bg-[#1d2c22] text-[#234b35] dark:text-[#88c99e] flex items-center justify-center shrink-0">
                {item.icon === "lightning" && (
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  </svg>
                )}
                {item.icon === "wrench" && (
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                    />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                )}
                {item.icon === "book" && (
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                    />
                  </svg>
                )}
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-serif font-bold text-xs text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2a4d38] dark:group-hover:text-[#52a578] transition-colors truncate">
                  {item.title}
                </h3>
                <p class="text-[11px] text-[#636c65] dark:text-[#919c93] mt-0.5 leading-snug line-clamp-1">
                  {item.description}
                </p>
              </div>
              <span class="text-xs text-[#636c65] dark:text-[#88958c] group-hover:text-[#234b35] dark:group-hover:text-[#52a578] group-hover:translate-x-0.5 transition-all">
                →
              </span>
            </a>
          ))}
        </div>
      </article>

      <!-- Columna 3: Notas recientes -->
      <article class="flex flex-col" id="notas">
        <div class="flex items-center justify-between pb-3 border-b border-[#dedfd5] dark:border-[#27332b]">
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-[#2d4b3b] dark:text-[#52a578]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
            <h2 class="font-serif text-xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1]">
              Notas recientes
            </h2>
          </div>
          <a
            href="/notas"
            class="text-xs font-semibold text-[#48534b] dark:text-[#88c99e] hover:text-[#233d2e] dark:hover:text-[#b0e8c2] inline-flex items-center gap-1"
          >
            Ver todas <span>→</span>
          </a>
        </div>

        <div class="divide-y divide-[#e5e6dd] dark:divide-[#243027]">
          {recentResources.map((note) => (
            <a
              href={note.href}
              target="_blank"
              rel="noreferrer"
              class="group py-3 flex items-center gap-3.5 hover:bg-white/50 dark:hover:bg-[#1a231d]/60 px-1 rounded-lg transition-colors"
            >
              <img
                src={note.image}
                alt={note.title}
                width="66"
                height="38"
                loading="lazy"
                class="w-16 h-10 object-cover rounded-md shrink-0 shadow-2xs border border-[#e2e4dc] dark:border-[#2b3930]"
              />
              <div class="min-w-0 flex-1">
                <h3 class="font-serif font-bold text-xs text-[#17231e] dark:text-[#f0f5f1] group-hover:text-[#2a4d38] dark:group-hover:text-[#52a578] transition-colors line-clamp-1">
                  {note.title}
                </h3>
                <p class="text-[11px] text-[#636c65] dark:text-[#919c93] mt-0.5">{note.date}</p>
              </div>
            </a>
          ))}
        </div>
      </article>
    </section>

    <!-- Section: Entre lecturas -->
    <BookShelf />

    <!-- Section: AHORA MISMO -->
    <section
      class="bg-[#edf0e7] dark:bg-[#18211b] rounded-2xl p-6 sm:p-7 border border-[#dbe0d4] dark:border-[#27342b]"
      id="sobre-mi"
      aria-labelledby="now-title"
    >
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 items-center">
        <!-- Photo -->
        <div class="md:col-span-4 rounded-xl overflow-hidden shadow-xs border border-[#d5dad0] dark:border-[#28362d] bg-[#e2e6de] dark:bg-[#1f2a22] aspect-[16/10]">
          <img
            src="/images/ahora-mismo-desk.webp"
            alt="Espacio de trabajo de Eduardo con portátil Arch Linux, libreta y taza de Tux"
            width="213"
            height="110"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Copy -->
        <div class="md:col-span-5 flex flex-col justify-center">
          <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-wider text-[#264836] dark:text-[#6ec490] uppercase mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#27784f] dark:bg-[#52a578]"></span>
            <span>AHORA MISMO</span>
          </div>
          <h2
            id="now-title"
            class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1]"
          >
            Programando, cocinando y aprendiendo.
          </h2>
          <p class="text-xs sm:text-[13px] text-[#556059] dark:text-[#9ea9a1] leading-relaxed mt-2.5">
            Trabajo en mis proyectos, preparo nuevas recetas, exploro herramientas de{" "}
            <strong class="font-semibold text-[#1f3729] dark:text-[#88c99e]">Linux</strong> y
            siempre tengo algún libro en la mesa. Aquí comparto lo que voy construyendo y lo que voy
            descubriendo.
          </p>
          <div class="mt-4">
            <a
              href="https://github.com/soker90"
              target="_blank"
              rel="noreferrer"
