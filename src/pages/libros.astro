---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BookCard from "../components/BookCard.astro";
import {
  books,
  currentlyReading,
  recentReads,
  recommendations,
} from "../data/books";
import "../styles/global.css";
---
<BaseLayout title="Entre lecturas — Eduardo Parra" description="Mis libros actuales, últimas lecturas, sinopsis, datos bibliográficos y reseñas personales.">
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-[#17231e] focus:shadow-md focus:ring-2 focus:ring-[#2d4b3b] dark:focus:bg-[#1a241e] dark:focus:text-white">Saltar al contenido</a>
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="mb-10 border-b border-[#e5e4dc] pb-8 dark:border-[#222b25]">
      <a href="/" class="mb-5 inline-flex text-xs font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a la portada</a>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#2c4b3a] dark:text-[#6ec490]">LECTURAS Y MEMORIA</p>
      <h1 class="font-serif text-4xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">Entre lecturas</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#555f58] dark:text-[#9ea9a1] sm:text-lg">Una estantería personal alimentada por mi registro de lecturas: libros en curso, lecturas terminadas y títulos pendientes, con sus datos bibliográficos y mis reseñas.</p>
      <p class="mt-4 text-xs text-[#636c65] dark:text-[#95a097]">{books.length} libros en mi registro</p>
    </header>

    {currentlyReading.length > 0 && <section aria-labelledby="currently-reading-title" class="mb-12">
      <div class="mb-5 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Ahora</p><h2 id="currently-reading-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Estoy leyendo</h2></div><span class="text-sm text-[#636c65] dark:text-[#95a097]">{currentlyReading.length} {currentlyReading.length === 1 ? "libro" : "libros"}</span></div>
      <div class="grid gap-4 sm:grid-cols-2">{currentlyReading.map((book) => <BookCard book={book} featured />)}</div>
    </section>}

    {recentReads.length > 0 && <section aria-labelledby="recent-reads-title" class="mb-12">
      <div class="mb-5 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Terminados</p><h2 id="recent-reads-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Mis últimas lecturas</h2></div><span class="text-sm text-[#636c65] dark:text-[#95a097]">{recentReads.length} libros</span></div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">{recentReads.map((book) => <BookCard book={book} />)}</div>
    </section>}

    {recommendations.length > 0 && <section id="recomendaciones" aria-labelledby="recommendations-title" class="mb-12">
      <div class="mb-5 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Próximos</p><h2 id="recommendations-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">En mi lista</h2><p class="mt-2 text-sm text-[#555f58] dark:text-[#a8b2aa]">Libros que tengo pendientes y que me gustaría leer.</p></div><span class="text-sm text-[#636c65] dark:text-[#95a097]">{recommendations.length} pendientes</span></div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">{recommendations.map((book) => <BookCard book={book} />)}</div>
    </section>}

    <aside class="rounded-2xl border border-[#dedcd2] bg-[#edf0e7] p-6 dark:border-[#27342b] dark:bg-[#202e25]">
      <p class="font-serif text-xl italic leading-relaxed text-[#2d4b3b] dark:text-[#c8e5d0]">«Un buen libro siempre es una conversación con alguien más sabio.»</p>
      <p class="mt-4 text-sm text-[#555f58] dark:text-[#a8b2aa]">Cada ficha reúne los datos bibliográficos disponibles, la sinopsis, las reseñas externas y otros libros relacionados.</p>
    </aside>
  </main>
</BaseLayout>
