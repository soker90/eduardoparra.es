---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { books } from "../data/books";
import "../styles/global.css";
---
<BaseLayout title="Entre lecturas — Eduardo Parra" description="Libros que estoy leyendo, que me han marcado o que quiero leer.">
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="mb-9 border-b border-[#e5e4dc] pb-8 dark:border-[#222b25]">
      <a href="/" class="mb-5 inline-flex text-xs font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a la portada</a>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#2c4b3a] dark:text-[#6ec490]">LECTURAS Y MEMORIA</p>
      <h1 class="font-serif text-4xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">Entre lecturas</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#555f58] dark:text-[#9ea9a1] sm:text-lg">Una pequeña estantería personal: libros que estoy leyendo, que me han marcado o que quiero leer. La lista se alimenta de la misma selección que aparece en la portada.</p>
    </header>
    <section aria-labelledby="books-title">
      <div class="mb-5 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Mi estantería</p><h2 id="books-title" class="mt-1 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Libros</h2></div><span class="text-sm text-[#636c65] dark:text-[#919c93]">{books.length} libros</span></div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {books.map((book) => <article class="group min-w-0 overflow-hidden rounded-2xl border border-[#dedcd2] bg-white/70 p-3 transition-colors hover:bg-white dark:border-[#27342b] dark:bg-[#151d17] dark:hover:bg-[#1a241e]">
          <div class="relative overflow-hidden rounded-xl border border-[#dedcd2] bg-[#edf0e7] dark:border-[#27342b] dark:bg-[#202e25]"><img src={book.cover} alt={book.coverAlt ?? `Portada de ${book.title}`} width="200" height="300" loading="lazy" decoding="async" class="aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            <span class:list={["absolute bottom-2 right-2 rounded-md px-2 py-1 text-[10px] font-bold shadow-sm backdrop-blur-sm", book.status === "Favorito" && "bg-white/95 text-[#9e3328] dark:bg-[#121914]/90 dark:text-[#f28b82]", book.status === "Leyendo" && "bg-white/95 text-[#1b5c34] dark:bg-[#121914]/90 dark:text-[#88c99e]", book.status === "Terminado" && "bg-white/95 text-[#1b5c34] dark:bg-[#121914]/90 dark:text-[#88c99e]", book.status === "Pendiente" && "bg-white/95 text-[#8f5a18] dark:bg-[#121914]/90 dark:text-[#fdd663]"]}>{book.status}</span>
          </div>
          <h3 class="mt-3 font-serif text-base font-bold leading-snug text-[#17231e] dark:text-[#f2f6f3]">{book.title}</h3>
          <p class="mt-1 text-xs text-[#636c65] dark:text-[#919c93]">{book.author}</p>
        </article>)}
      </div>
    </section>
    <aside class="mt-10 rounded-2xl border border-[#dedcd2] bg-[#edf0e7] p-6 dark:border-[#27342b] dark:bg-[#202e25]">
      <p class="font-serif text-xl italic leading-relaxed text-[#2d4b3b] dark:text-[#c8e5d0]">“Un buen libro siempre es una conversación con alguien más sabio.”</p>
      <p class="mt-4 text-sm text-[#555f58] dark:text-[#a8b2aa]">También puedes explorar mis <a href="/notas" class="font-semibold underline underline-offset-4">notas</a> y los <a href="/proyectos" class="font-semibold underline underline-offset-4">proyectos</a> que voy construyendo.</p>
    </aside>
  </main>
</BaseLayout>