---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

const work = [
  { name: "Alcázar Vive", description: "Mejoras de rendimiento, accesibilidad y experiencia de navegación.", status: "En progreso" },
  { name: "aur-maintainer", description: "Automatización del mantenimiento de paquetes AUR, con una acción reutilizable.", status: "En progreso" },
  { name: "Recetas", description: "Nuevas recetas caseras y mejoras en el diseño del blog.", status: "En progreso" },
  { name: "Licitalcázar", description: "Seguimiento de contratos públicos y mejoras en los datos.", status: "Mantenimiento" },
];
const updatedAt = new Intl.DateTimeFormat("es-ES", { month: "long", year: "numeric", timeZone: "Europe/Madrid" }).format(new Date());

const learning = [
  { name: "Astro", description: "Arquitectura, contenido y rendimiento." },
  { name: "React y TypeScript", description: "Interfaces y herramientas para proyectos personales." },
  { name: "Linux y automatización", description: "Herramientas pequeñas que resuelven problemas reales." },
  { name: "Cocina casera", description: "Recetas sencillas para el día a día." },
];
---
<BaseLayout title="Ahora mismo — Eduardo Parra" description="En qué estoy trabajando, qué estoy aprendiendo y qué estoy leyendo ahora.">
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
    <header class="mb-10 grid gap-8 border-b border-[#e5e4dc] pb-8 dark:border-[#222b25] md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <a href="/" class="mb-5 inline-flex text-xs font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]">← Volver a la portada</a>
        <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#2c4b3a] dark:text-[#6ec490]">ACTUALIZACIÓN PERSONAL</p>
        <h1 class="font-serif text-4xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] sm:text-5xl">Ahora mismo</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#555f58] dark:text-[#9ea9a1] sm:text-lg">En qué estoy trabajando, qué estoy aprendiendo y qué me apetece explorar. Una instantánea de mis proyectos e intereses.</p>
      </div>
      <p class="rounded-xl border border-[#dedcd2] bg-white/70 px-4 py-3 text-sm text-[#555f58] dark:border-[#27342b] dark:bg-[#151d17] dark:text-[#a8b2aa]">Actualizado en {updatedAt}</p>
    </header>
    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <section aria-labelledby="work-title" class="rounded-2xl border border-[#dedcd2] bg-white/60 p-5 sm:p-7 dark:border-[#27342b] dark:bg-[#151d17]">
        <p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Entre manos</p>
        <h2 id="work-title" class="mt-2 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">En qué estoy trabajando</h2>
        <ul class="mt-6 divide-y divide-[#e5e4dc] dark:divide-[#27342b]">
          {work.map((item) => <li class="flex gap-3 py-4 first:pt-0 last:pb-0"><span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#5c946b]" aria-hidden="true"></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold text-[#17231e] dark:text-[#f2f6f3]">{item.name}</h3><span class="rounded-full bg-[#e8eee5] px-2.5 py-1 text-xs text-[#2d4b3b] dark:bg-[#203126] dark:text-[#a7d9b6]">{item.status}</span></div><p class="mt-1 text-sm leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{item.description}</p></div></li>)}
        </ul>
      </section>
      <div class="space-y-6">
        <section aria-labelledby="learning-title" class="rounded-2xl border border-[#dedcd2] bg-white/60 p-5 sm:p-7 dark:border-[#27342b] dark:bg-[#151d17]">
          <p class="text-xs font-bold uppercase tracking-widest text-[#2d4b3b] dark:text-[#6ec490]">Curiosidad constante</p>
          <h2 id="learning-title" class="mt-2 font-serif text-2xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Aprendiendo</h2>
          <ul class="mt-5 space-y-4">{learning.map((item) => <li><h3 class="font-semibold text-[#17231e] dark:text-[#f2f6f3]">{item.name}</h3><p class="mt-1 text-sm text-[#555f58] dark:text-[#a8b2aa]">{item.description}</p></li>)}</ul>
        </section>
        <section class="rounded-2xl border border-[#dedcd2] bg-[#edf0e7] p-6 dark:border-[#27342b] dark:bg-[#202e25]">
          <p class="font-serif text-xl italic leading-relaxed text-[#2d4b3b] dark:text-[#c8e5d0]">«Un poco de progreso cada día se convierte en algo grande.»</p>
        </section>
        <section class="rounded-2xl border border-[#dedcd2] bg-white/60 p-5 dark:border-[#27342b] dark:bg-[#151d17]">
          <h2 class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f2f6f3]">Por aquí también</h2>
          <div class="mt-4 flex flex-wrap gap-3"><a class="text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]" href="/proyectos">Proyectos →</a><a class="text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]" href="/notas">Notas →</a><a class="text-sm font-semibold text-[#2d4b3b] hover:underline dark:text-[#8bd4a7]" href="/libros">Libros →</a></div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>