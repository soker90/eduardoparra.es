---
---

<header class="w-full border-b border-[#e5e4dc] bg-[#fbf8f1]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-6">
    <!-- Wordmark / Logo -->
    <a
      href="/"
      class="font-serif text-2xl font-bold tracking-tight text-[#17231e] hover:opacity-90 transition-opacity whitespace-nowrap"
      aria-label="Eduardo Parra, inicio"
    >
      Eduardo Parra
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-7 text-[14px] font-medium text-[#505a54]"
      aria-label="Navegación principal"
    >
      <a
        href="#inicio"
        class="text-[#17231e] font-semibold relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-[#2d4b3b] after:rounded-full"
        aria-current="page"
      >
        Inicio
      </a>
      <a href="#proyectos" class="hover:text-[#2d4b3b] transition-colors py-1">
        Proyectos
      </a>
      <a href="#recetas" class="hover:text-[#2d4b3b] transition-colors py-1">
        Recetas
      </a>
      <a href="#utilidades" class="hover:text-[#2d4b3b] transition-colors py-1">
        Utilidades
      </a>
      <a href="#notas" class="hover:text-[#2d4b3b] transition-colors py-1">
        Notas
      </a>
      <a href="#sobre-mi" class="hover:text-[#2d4b3b] transition-colors py-1">
        Sobre mí
      </a>
    </nav>

    <!-- Header Actions (Search & Theme Toggle) -->
    <div class="flex items-center gap-3">
      <!-- Search Button -->
      <button
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#556059] hover:text-[#17231e] hover:bg-[#eceee5] transition-colors"
        aria-label="Buscar en la web"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Theme Switcher: Sun & Toggle with Moon -->
      <div class="flex items-center gap-1.5 pl-1" aria-label="Cambiar tema">
        <span class="text-[#717b74]" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </span>
        <button
          id="theme-toggle"
          type="button"
          class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border border-[#d6dad1] bg-[#e8ebe3] p-0.5 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4b3b]"
          role="switch"
          aria-checked="false"
          aria-label="Activar modo oscuro"
        >
          <span id="theme-toggle-thumb" class="inline-flex h-3.5 w-3.5 translate-x-0 transform items-center justify-center rounded-full bg-[#1b2622] text-white shadow-xs transition-transform">
            <svg id="theme-toggle-icon" xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm9 4a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM4 11a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1Zm14.36-5.36a1 1 0 0 1 0 1.42l-.7.7a1 1 0 1 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0ZM7.76 16.24a1 1 0 0 1 0 1.42l-.7.7a1 1 0 1 1-1.42-1.42l.7-.7a1 1 0 0 1 1.42 0Zm10.6 2.12a1 1 0 0 1-1.42 0l-.7-.7a1 1 0 0 1 1.42-1.42l.7.7a1 1 0 0 1 0 1.42ZM7.76 7.76a1 1 0 0 1-1.42 0l-.7-.7a1 1 0 1 1 1.42-1.42l.7.7a1 1 0 0 1 0 1.42ZM12 19a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1Z"/></svg>
          </span>
        </button>
      </div>

      <!-- Mobile navigation menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-9 h-9 rounded-lg flex items-center justify-center text-[#505a54] hover:bg-[#eceee5] transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#e5e4dc] px-4 py-3 bg-[#fbf8f1]">
    <nav class="flex flex-col gap-2 text-sm font-medium text-[#505a54]">
      <a
        href="#inicio"
        class="px-2 py-1.5 rounded-md hover:bg-[#eceee5] text-[#17231e] font-semibold"
      >
        Inicio
      </a>
      <a href="#proyectos" class="px-2 py-1.5 rounded-md hover:bg-[#eceee5]">
        Proyectos
      </a>
      <a href="#recetas" class="px-2 py-1.5 rounded-md hover:bg-[#eceee5]">
        Recetas
      </a>
      <a href="#utilidades" class="px-2 py-1.5 rounded-md hover:bg-[#eceee5]">
        Utilidades
      </a>
      <a href="#notas" class="px-2 py-1.5 rounded-md hover:bg-[#eceee5]">
        Notas
      </a>
      <a href="#sobre-mi" class="px-2 py-1.5 rounded-md hover:bg-[#eceee5]">
        Sobre mí
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));
      menu.classList.toggle("hidden");
    });
  }

  const themeToggle = document.getElementById("theme-toggle");
  const themeThumb = document.getElementById("theme-toggle-thumb");
  const themeIcon = document.getElementById("theme-toggle-icon");
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  if (themeToggle instanceof HTMLButtonElement && themeThumb instanceof HTMLElement) {
    const syncThemeControl = () => {
      const isDark = document.documentElement.classList.contains("dark");
      themeToggle.setAttribute("aria-checked", String(isDark));
      themeToggle.setAttribute("aria-label", isDark ? "Activar modo claro" : "Activar modo oscuro");
      themeThumb.classList.toggle("translate-x-4", isDark);
      themeThumb.classList.toggle("translate-x-0", !isDark);
      themeThumb.classList.toggle("bg-[#f4f1e8]", isDark);
      themeThumb.classList.toggle("bg-[#1b2622]", !isDark);
      themeThumb.classList.toggle("text-[#17231e]", isDark);
      themeThumb.classList.toggle("text-white", !isDark);
      if (themeIcon) {
        themeIcon.innerHTML = isDark
          ? '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>'
          : '<path d="M12 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm9 4a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM4 11a1 1 0 1 1 0 2H3a1 1 0 0 1 0-2h1Z"></path>';
      }
      if (themeMeta) themeMeta.content = isDark ? "#111a15" : "#fbf8f1";
    };

    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("eduardoparra-theme", isDark ? "dark" : "light");
      } catch {
        // The theme still works for this session when storage is unavailable.
      }
      syncThemeControl();
    });

    syncThemeControl();
  }
</script>
