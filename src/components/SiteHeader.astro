---
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const prefix = isHome ? "" : "/";
---

<header class="sticky top-0 z-40 w-full border-b border-[#e5e4dc] dark:border-[#222b25] bg-[#fbf8f1]/90 dark:bg-[#121815]/90 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-6">
    <!-- Wordmark / Logo -->
    <a
      href="/"
      class="font-serif text-2xl font-bold tracking-tight text-[#17231e] dark:text-[#f2f6f3] hover:opacity-90 transition-opacity whitespace-nowrap"
      aria-label="Eduardo Parra, inicio"
    >
      Eduardo Parra
    </a>

    <!-- Desktop Navigation -->
    <nav
      id="desktop-nav"
      class="hidden md:flex items-center gap-7 text-[14px] font-medium text-[#505a54] dark:text-[#9ea8a0]"
      aria-label="Navegación principal"
    >
      <a
        href={isHome ? "#inicio" : "/"}
        class:list={[
          "nav-link transition-colors py-1",
          isHome
            ? "text-[#17231e] dark:text-white font-semibold relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-[#2d4b3b] dark:after:bg-[#52a578] after:rounded-full"
            : "hover:text-[#2d4b3b] dark:hover:text-[#52a578]",
        ]}
        aria-current={isHome ? "page" : undefined}
      >
        Inicio
      </a>
      <a
        href={`${prefix}#proyectos`}
        class="nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1"
      >
        Proyectos
      </a>
      <a
        href={`${prefix}#recetas`}
        class="nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1"
      >
        Recetas
      </a>
      <a
        href={`${prefix}#utilidades`}
        class="nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1"
      >
        Utilidades
      </a>
      <a
        href={`${prefix}#notas`}
        class="nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1"
      >
        Notas
      </a>
      <a
        href={`${prefix}#sobre-mi`}
        class="nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1"
      >
        Sobre mí
      </a>
    </nav>

    <!-- Header Actions (Search & Theme Toggle) -->
    <div class="flex items-center gap-3">
      <!-- Search Button -->
      <button
        id="site-search-open"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#556059] dark:text-[#a0aaa2] hover:text-[#17231e] dark:hover:text-white hover:bg-[#eceee5] dark:hover:bg-[#1e2621] transition-colors"
        aria-label="Buscar en la web"
        aria-haspopup="dialog"
        aria-controls="site-search-dialog"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Theme Switcher: Sun & Toggle with Moon -->
      <div class="flex items-center gap-1.5 pl-1" aria-label="Cambiar tema">
        <span class="text-[#717b74] dark:text-[#8d978f]" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </span>
        <button
          id="theme-toggle"
          type="button"
          class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border border-[#d6dad1] dark:border-[#2d3a31] bg-[#e8ebe3] dark:bg-[#1b2620] p-0.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2d4b3b] dark:focus-visible:ring-[#52a578]"
          role="switch"
          aria-checked="false"
          aria-label="Alternar modo oscuro"
        >
          <span
            id="theme-toggle-thumb"
            class="inline-block h-3.5 w-3.5 transform rounded-full bg-[#1b2622] dark:bg-[#52a578] shadow-xs text-white flex items-center justify-center transition-transform duration-200 translate-x-0 dark:translate-x-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-2.5 h-2.5 fill-current"
              viewBox="0 0 24 24"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>
        </button>
      </div>

      <!-- Mobile navigation menu button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden w-9 h-9 rounded-lg flex items-center justify-center text-[#505a54] dark:text-[#a0aaa2] hover:bg-[#eceee5] dark:hover:bg-[#1e2621] transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#e5e4dc] dark:border-[#222b25] px-4 py-3 bg-[#fbf8f1] dark:bg-[#121815]"
  >
    <nav class="flex flex-col gap-2 text-sm font-medium text-[#505a54] dark:text-[#9ea8a0]">
      <a
        href={isHome ? "#inicio" : "/"}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e] text-[#17231e] dark:text-white font-semibold"
      >
        Inicio
      </a>
      <a
        href={`${prefix}#proyectos`}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]"
      >
        Proyectos
      </a>
      <a
        href={`${prefix}#recetas`}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]"
      >
        Recetas
      </a>
      <a
        href={`${prefix}#utilidades`}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]"
      >
        Utilidades
      </a>
      <a
        href={`${prefix}#notas`}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]"
      >
        Notas
      </a>
      <a
        href={`${prefix}#sobre-mi`}
        class="mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]"
      >
        Sobre mí
      </a>
    </nav>
  </div>
</header>

<dialog
  id="site-search-dialog"
  aria-labelledby="site-search-title"
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-4 backdrop:bg-[#17231e]/50 dark:backdrop:bg-black/70 sm:m-auto sm:h-auto sm:max-h-[min(80vh,42rem)] sm:max-w-xl sm:rounded-2xl"
>
  <section class="mx-auto mt-[8vh] w-full max-w-xl overflow-hidden rounded-2xl border border-[#dedcd2] dark:border-[#27332b] bg-[#fbf8f1] dark:bg-[#161d19] shadow-2xl sm:mt-0">
    <div class="flex items-center justify-between border-b border-[#e5e4dc] dark:border-[#27332b] px-5 py-4">
      <h2
        id="site-search-title"
        class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f0f4f1]"
      >
        Buscar en la web
      </h2>
      <button
        id="site-search-close"
        type="button"
        class="rounded-lg px-3 py-1.5 text-sm text-[#505a54] dark:text-[#9ea8a0] hover:bg-[#eceee5] dark:hover:bg-[#202923] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#2d4b3b] dark:focus-visible:outline-[#52a578]"
      >
        Cerrar <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="p-4">
      <label for="site-search-input" class="sr-only">
        Buscar proyectos, recetas, notas y secciones
      </label>
      <input
        id="site-search-input"
        type="search"
        placeholder="Busca proyectos, recetas, notas…"
        autocomplete="off"
        class="w-full rounded-xl border border-[#d6dad1] dark:border-[#2d3a31] bg-white dark:bg-[#101513] px-4 py-3 text-base text-[#17231e] dark:text-[#f0f4f1] outline-none placeholder:text-[#7a817b] dark:placeholder:text-[#6a746d] focus:border-[#2d4b3b] dark:focus:border-[#52a578] focus:ring-2 focus:ring-[#2d4b3b]/20 dark:focus:ring-[#52a578]/20"
      />
      <p
        id="site-search-status"
        role="status"
        aria-live="polite"
        class="mt-3 px-1 text-xs text-[#69726b] dark:text-[#88928a]"
      >
        Busca títulos y enlaces de esta página.
      </p>
      <ul
        id="site-search-results"
        class="mt-2 max-h-[50vh] space-y-1 overflow-y-auto"
        aria-label="Resultados de búsqueda"
      ></ul>
    </div>
    <p class="border-t border-[#e5e4dc] dark:border-[#27332b] px-5 py-3 text-xs text-[#69726b] dark:text-[#88928a]">
      Consejo: pulsa{" "}
      <kbd class="rounded border border-[#d6dad1] dark:border-[#2d3a31] bg-white dark:bg-[#101513] px-1.5 py-0.5 font-mono">
        Esc
      </kbd>{" "}
      para cerrar.
    </p>
  </section>
</dialog>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));
      menu.classList.toggle("hidden");
    });
  }

  const searchOpen = document.getElementById("site-search-open");
  const searchDialog = document.getElementById("site-search-dialog");
  const searchClose = document.getElementById("site-search-close");
  const searchInput = document.getElementById("site-search-input");
  const searchResults = document.getElementById("site-search-results");
  const searchStatus = document.getElementById("site-search-status");

  if (
    searchOpen instanceof HTMLButtonElement &&
    searchDialog instanceof HTMLDialogElement &&
    searchClose instanceof HTMLButtonElement &&
    searchInput instanceof HTMLInputElement &&
    searchResults instanceof HTMLUListElement &&
    searchStatus instanceof HTMLElement
  ) {
    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("es");

    const collectSearchItems = () => {
      const items = new Map<string, { title: string; href: string; context: string }>();
      document.querySelectorAll<HTMLElement>("main h1, main h2, main h3").forEach((heading) => {
        const title = heading.textContent?.trim();
        const target = heading.id
          ? `#${heading.id}`
          : heading.closest("section[id], article[id]")?.getAttribute("id");
        if (title && target) items.set(target, { title, href: target, context: "Sección" });
      });
      document.querySelectorAll<HTMLAnchorElement>("main a[href]").forEach((link) => {
        const title = link.textContent?.replace(/\s+/g, " ").trim();
        const href = link.getAttribute("href");
        if (!title || !href || title.length < 2 || href.startsWith("javascript:")) return;
        const key = `${href}|${title}`;
        if (!items.has(key)) {
          items.set(key, {
            title,
            href,
            context:
              link.closest("article")?.querySelector("h2, h3")?.textContent?.trim() ?? "Enlace",
          });
        }
      });
      return [...items.values()];
    };

    let searchItems = collectSearchItems();

    const renderSearchResults = () => {
      const query = normalize(searchInput.value.trim());
      searchResults.replaceChildren();
      if (!query) {
        searchStatus.textContent = "Busca títulos y enlaces de esta página.";
        return;
      }

      const matches = searchItems
        .filter((item) => normalize(`${item.title} ${item.context} ${item.href}`).includes(query))
        .slice(0, 12);

      searchStatus.textContent = matches.length
        ? `${matches.length} resultado${matches.length === 1 ? "" : "s"}`
        : "No hay resultados. Prueba con otros términos.";

      for (const item of matches) {
        const li = document.createElement("li");
        const link = document.createElement("a");
        link.href = item.href;
        link.className =
          "flex flex-col gap-0.5 rounded-xl px-4 py-3 text-[#17231e] dark:text-[#e8eee9] no-underline hover:bg-[#eceee5] dark:hover:bg-[#202a23] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#2d4b3b] dark:focus-visible:outline-[#52a578]";
        const title = document.createElement("span");
        title.className = "text-sm font-semibold";
        title.textContent = item.title;
        const context = document.createElement("span");
        context.className = "text-xs text-[#69726b] dark:text-[#8d988f]";
        context.textContent = item.context;
        link.append(title, context);
        link.addEventListener("click", () => searchDialog.close());
        li.append(link);
        searchResults.append(li);
      }
    };

    const openSearch = () => {
      searchItems = collectSearchItems();
      searchDialog.showModal();
      searchInput.value = "";
      renderSearchResults();
      window.requestAnimationFrame(() => searchInput.focus());
    };

    searchOpen.addEventListener("click", openSearch);
    searchClose.addEventListener("click", () => searchDialog.close());
    searchInput.addEventListener("input", renderSearchResults);
    searchDialog.addEventListener("click", (event) => {
      if (event.target === searchDialog) searchDialog.close();
    });
    document.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openSearch();
      } else if (
        event.key === "/" &&
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)
      ) {
        event.preventDefault();
        openSearch();
      }
    });
  }

  // --- Theme Toggle Logic ---
  const themeToggle = document.getElementById("theme-toggle");
  const updateThemeUI = (isDark: boolean) => {
    if (themeToggle) {
      themeToggle.setAttribute("aria-checked", String(isDark));
      themeToggle.setAttribute("title", isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro");
    }
    const metaTheme = document.getElementById("theme-color-meta");
    if (metaTheme) {
      metaTheme.setAttribute("content", isDark ? "#121815" : "#fbf8f1");
    }
  };

  const initialDark = document.documentElement.classList.contains("dark");
  updateThemeUI(initialDark);

  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (_) {}
      updateThemeUI(isDark);
    });
  }

  // --- Scroll Spy & Active Nav Highlighting ---
  const sectionIds = ["inicio", "proyectos", "recetas", "utilidades", "notas", "sobre-mi"];
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>("#desktop-nav a.nav-link");
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(
    "#mobile-menu a.mobile-nav-link",
  );

  const setActiveNav = (activeId: string) => {
    desktopLinks.forEach((link) => {
      const href = link.getAttribute("href")?.replace("#", "");
      const isActive = href === activeId;
      if (isActive) {
        link.setAttribute("aria-current", "page");
        link.className =
          "nav-link text-[#17231e] dark:text-white font-semibold relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-[#2d4b3b] dark:after:bg-[#52a578] after:rounded-full transition-colors";
      } else {
        link.removeAttribute("aria-current");
        link.className =
          "nav-link hover:text-[#2d4b3b] dark:hover:text-[#52a578] transition-colors py-1";
      }
    });

    mobileLinks.forEach((link) => {
      const href = link.getAttribute("href")?.replace("#", "");
      const isActive = href === activeId;
      if (isActive) {
        link.setAttribute("aria-current", "page");
        link.className =
          "mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e] text-[#17231e] dark:text-white font-semibold bg-[#edf0eb]/60 dark:bg-[#1b241e]/70";
      } else {
        link.removeAttribute("aria-current");
        link.className =
          "mobile-nav-link px-2 py-1.5 rounded-md hover:bg-[#eceee5] dark:hover:bg-[#1b241e]";
      }
    });
  };

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((sec): sec is HTMLElement => sec !== null);

  if ("IntersectionObserver" in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntries = entries.filter((entry) => entry.isIntersecting);
        if (visibleEntries.length > 0) {
          // Sort by highest intersection ratio or position
          visibleEntries.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          const currentId = visibleEntries[0].target.id;
          if (currentId) setActiveNav(currentId);
        }
      },
      {
        rootMargin: "-20% 0px -55% 0px",
        threshold: [0, 0.2, 0.5, 0.8],
      },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
