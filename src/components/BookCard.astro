---
import type { Book } from "../data/books";
import { bookIssueUrl, formatBookDate, formatPublishedYear } from "../data/books";
interface Props { book: Book; featured?: boolean }
const { book, featured = false } = Astro.props;
const issueUrl = bookIssueUrl(book);
const year = formatPublishedYear(book.publishedDate);
const metadata = [
  book.publisher ? ["Editorial", book.publisher] : null,
  year ? ["Año", year] : null,
  book.pageCount && book.pageCount > 0 ? ["Páginas", String(book.pageCount)] : null,
  book.language ? ["Idioma", book.language.toUpperCase()] : null,
  book.isbn13 ? ["ISBN", book.isbn13] : book.isbn10 ? ["ISBN", book.isbn10] : null,
].filter((item): item is string[] => item !== null);
---
<article class:list={["group min-w-0 rounded-2xl border border-[#dedcd2] bg-white/75 p-3 dark:border-[#27342b] dark:bg-[#151d17]", featured && "sm:flex sm:gap-5 sm:p-4"]}>
  <a href={issueUrl} target="_blank" rel="noopener noreferrer" class:list={["mb-3 block overflow-hidden rounded-xl bg-[#e4e7df] dark:bg-[#202a22]", featured && "sm:mb-0 sm:w-36 sm:shrink-0"]} aria-label={`Ver ${book.title} en GitHub`}>
    {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="240" height="360" loading="lazy" decoding="async" class:list={["aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]", featured && "sm:h-full"]} /> : <div class="flex aspect-[2/3] items-center justify-center p-3 text-center text-xs text-[#636c65]">Portada no disponible</div>}
  </a>
  <div class="min-w-0 flex-1">
    <h3 class:list={["font-serif font-bold leading-snug text-[#17231e] dark:text-[#f0f5f1]", featured ? "text-lg" : "text-sm"]}><a href={issueUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">{book.title}</a></h3>
    <p class="mt-1 text-xs text-[#636c65] dark:text-[#95a097]">{book.authors.join(", ")}</p>
    {book.categories?.length ? <p class="mt-2 flex flex-wrap gap-1.5">{book.categories.slice(0, 3).map((category) => <span class="rounded-full bg-[#edf0e7] px-2 py-0.5 text-[10px] text-[#405548] dark:bg-[#26372c] dark:text-[#b7d9c1]">{category}</span>)}</p> : null}
    {book.personalRating && book.personalRating > 0 ? <p class="mt-2 text-xs text-[#80591d] dark:text-[#f2cf82]" aria-label={`Mi valoración: ${book.personalRating} sobre 5`}>★ {book.personalRating.toLocaleString("es-ES", { maximumFractionDigits: 1 })}/5 <span class="text-[#777] dark:text-[#a9b3aa]">· Goodreads</span></p> : book.goodreadsRating && book.goodreadsRating > 0 ? <p class="mt-2 text-xs text-[#80591d] dark:text-[#f2cf82]" aria-label={`Valoración de Goodreads: ${book.goodreadsRating} sobre 5`}>★ {book.goodreadsRating.toLocaleString("es-ES", { maximumFractionDigits: 1 })}/5 <span class="text-[#777] dark:text-[#a9b3aa]">· Goodreads</span></p> : null}
    {featured && book.description ? <p class="mt-3 text-xs leading-relaxed text-[#555f58] dark:text-[#a8b2aa]">{book.description}</p> : null}
    {book.progressPercent !== undefined && book.state === "reading" ? <div class="mt-3"><div class="mb-1 flex justify-between text-[10px] text-[#636c65] dark:text-[#95a097]"><span>Progreso</span><span>{book.progressPercent}%</span></div><div class="h-1.5 overflow-hidden rounded-full bg-[#dfe4da] dark:bg-[#2b3930]"><div class="h-full rounded-full bg-[#398357]" style={`width: ${Math.min(100, Math.max(0, book.progressPercent))}%`}></div></div></div> : null}
    <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-[#636c65] dark:text-[#95a097]">{metadata.slice(0, featured ? 5 : 2).map(([label, value]) => <span><strong>{label}:</strong> {value}</span>)}{book.startedAt && book.state === "reading" ? <span>Desde {formatBookDate(book.startedAt)}</span> : null}{book.completedAt ? <span>Terminado {formatBookDate(book.completedAt)}</span> : null}</div>
    {book.description && !featured ? <details class="mt-3 text-xs text-[#555f58] dark:text-[#a8b2aa]"><summary class="cursor-pointer font-semibold text-[#2d4b3b] hover:underline dark:text-[#88c99e]">Ver sinopsis y todos los datos</summary><p class="mt-2 leading-relaxed">{book.description}</p><dl class="mt-3 grid grid-cols-2 gap-2">{metadata.slice(2).map(([label, value]) => <div><dt class="text-[10px] text-[#737b75]">{label}</dt><dd class="break-words font-medium">{value}</dd></div>)}</dl></details> : null}
  </div>
</article>
