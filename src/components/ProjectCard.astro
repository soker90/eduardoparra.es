---
import type { Project } from "../data/projects";
const { project } = Astro.props as { project: Project };
---
<article class="project-card">
  <div class="project-visual" class:has-image={Boolean(project.image)}>
    {project.image ? (
      <img
        class="project-image"
        src={project.image}
        alt={project.imageAlt ?? `Vista previa de ${project.name}`}
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
      />
    ) : (
      <div class="project-placeholder" aria-hidden="true">
        <span class="placeholder-window"><span></span><span></span><span></span><i></i><i></i><i></i><b>{project.name.split(/\s+/).map((part) => part[0]).join("").slice(0, 2)}</b></span>
      </div>
    )}
    <span class="project-visual-label">{project.tags[0]}</span>
  </div>
  <div class="project-body">
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <ul class="tag-list" aria-label="Tecnologías y categorías">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
    <div class="card-links">
      {project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
    </div>
  </div>
</article>

<style>
  .project-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: .7rem; background: var(--white); transition: border-color .18s ease, transform .18s ease; }
  .project-card:hover { border-color: #b7c6b8; transform: translateY(-2px); }
  .project-visual { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 7.7; min-height: 8rem; overflow: hidden; background: #e7e9df; color: #f4f2e9; }
  .project-card:nth-child(1) .project-visual { background: #e8ece7; }
  .project-card:nth-child(2) .project-visual { background: #17242a; }
  .project-card:nth-child(3) .project-visual { background: #d8c4a0; }
  .project-card:nth-child(4) .project-visual { background: #e5ebdf; }
  .project-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .project-placeholder { display: grid; width: 100%; height: 100%; place-items: center; padding: .8rem; }
  .placeholder-window { position: relative; display: flex; width: 88%; height: 78%; flex-direction: column; gap: .45rem; overflow: hidden; padding: 1.1rem .75rem .6rem; border: 1px solid #ffffff2b; border-radius: .35rem; background: #182a2b; box-shadow: 0 .5rem 1.2rem #14231e24; }
  .placeholder-window > span { position: absolute; top: .35rem; width: .25rem; height: .25rem; border-radius: 50%; background: #8aa795; }
  .placeholder-window > span:nth-child(1) { left: .45rem; }.placeholder-window > span:nth-child(2) { left: .85rem; }.placeholder-window > span:nth-child(3) { left: 1.25rem; }
  .placeholder-window i { display: block; width: 70%; height: 3px; border-radius: 2px; background: #548e76; }
  .placeholder-window i:nth-of-type(2) { width: 84%; background: #5e8ba5; }.placeholder-window i:nth-of-type(3) { width: 52%; background: #c4b376; }
  .placeholder-window b { position: absolute; right: .65rem; bottom: .2rem; color: #7fc0d8; font: 700 2rem/1 var(--serif); }
  .project-card:nth-child(3) .placeholder-window { background: #f2e6ce; border-color: #cbb68e; }.project-card:nth-child(3) .placeholder-window i { background: #b17b4e; }.project-card:nth-child(3) .placeholder-window b { color: #55705a; }
  .project-card:nth-child(4) .placeholder-window { width: 35%; height: 90%; border: .25rem solid #172b2a; border-radius: .8rem; background: #fbfaf5; }.project-card:nth-child(4) .placeholder-window b { color: #2e7c5a; font-size: 1rem; }
  .project-visual-label { position: absolute; right: .55rem; bottom: .55rem; padding: .3rem .45rem; border: 1px solid #ffffff40; border-radius: 999px; background: #14231eaa; color: #fffefa; font-size: .65rem; }
  .project-body { display: flex; flex: 1; flex-direction: column; padding: .85rem; }
  h3 { margin: 0; font: 700 1.2rem/1.2 var(--serif); letter-spacing: -.03em; }
  p { min-height: 4.1rem; margin: .45rem 0 .75rem; color: var(--muted); font-size: .84rem; line-height: 1.45; }
  .tag-list { display: flex; flex-wrap: wrap; gap: .3rem; margin: 0 0 1rem; padding: 0; list-style: none; }
  .tag-list li { border-radius: .3rem; padding: .3rem .4rem; background: var(--paper-alt); color: var(--green); font-size: .66rem; }
  .card-links { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin-top: auto; }
  .card-links a { font-size: .74rem; font-weight: 700; text-underline-offset: .2em; }
  @media (prefers-reduced-motion: reduce) { .project-card { transition: none; }.project-card:hover { transform: none; } }
  @media (max-width: 480px) { .project-visual { min-height: 8rem; } }
</style>
