---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group bg-white dark:bg-[#161d19] rounded-xl border border-[#dedfd5] dark:border-[#263129] overflow-hidden flex flex-col transition-all duration-200 hover:border-[#b8c7b8] dark:hover:border-[#3e5645] hover:-translate-y-0.5 hover:shadow-md">
  <!-- Visual Preview -->
  <div class="relative w-full aspect-[16/9] bg-[#eef0ea] dark:bg-[#1c241f] overflow-hidden border-b border-[#f0f2eb] dark:border-[#222b24]">
    {project.image ? (
      <img
        src={project.image}
        alt={project.imageAlt ?? `Captura de ${project.name}`}
        loading="lazy"
        decoding="async"
        width="600"
        height="310"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-[#21352a] text-[#a4c2b1] font-serif font-bold text-xl">
        {project.name}
      </div>
    )}
  </div>

  <!-- Body Content -->
  <div class="p-4 sm:p-4.5 flex flex-col flex-1">
    <h3 class="font-serif text-lg font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1] mb-1">
      {project.name}
    </h3>
    <p class="text-[12px] text-[#58625b] dark:text-[#97a299] leading-relaxed mb-3.5 min-h-[2.75rem]">
      {project.description}
    </p>

    <!-- Tags -->
    <ul class="flex flex-wrap gap-1.5 mb-4 list-none p-0" aria-label="Tecnologías utilizadas">
      {project.tags.map((tag) => (
        <li class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-[#edf0eb] dark:bg-[#1f2922] text-[#2c4938] dark:text-[#88c99e]">
          {tag}
        </li>
      ))}
    </ul>

    <!-- Action Links -->
    <div class="mt-auto pt-2 flex items-center gap-4 text-xs font-semibold text-[#1e3427] dark:text-[#90cca5]">
      {project.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-sm hover:text-[#2d5942] dark:hover:text-[#b4e6c3] hover:underline underline-offset-2 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#2d4b3b] dark:focus-visible:outline-[#52a578]"
        >
          {link.type === "github" ? (
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          ) : link.type === "marketplace" ? (
            <svg
              class="w-3.5 h-3.5 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
              />
            </svg>
          ) : (
            <svg
              class="w-3.5 h-3.5 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          )}
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</article>
