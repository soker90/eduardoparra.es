---
import {
  currentlyReading,
  recentReads,
  recommendations,
  bookDetailUrl,
  formatBookDate,
} from "../data/books";
---

<section
  class="rounded-2xl border border-[#dedcd2] bg-[#f2f0e6] p-5 sm:p-8 dark:border-[#27342b] dark:bg-[#18211b]"
  id="lecturas"
  aria-labelledby="reading-title"
>
  <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#2c4b3a] dark:text-[#6ec490]">LECTURAS Y MEMORIA</p>
      <h2 id="reading-title" class="font-serif text-2xl font-bold tracking-tight text-[#17231e] dark:text-[#f0f5f1] sm:text-3xl">Entre lecturas</h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#5e6660] dark:text-[#97a299]">Lo que estoy leyendo, mis últimas lecturas y los libros que tengo en la lista.</p>
    </div>
    <a href="/libros" class="inline-flex items-center gap-1 self-start text-xs font-semibold text-[#48534b] transition-colors hover:text-[#233d2e] dark:text-[#88c99e] dark:hover:text-[#b0e8c2] sm:self-auto">Ver estantería completa <span aria-hidden="true">→</span></a>
  </div>

  {currentlyReading.length > 0 && (
    <section aria-labelledby="currently-reading-title" class="mb-8">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[#398357]" aria-hidden="true"></span>
        <h3 id="currently-reading-title" class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f0f5f1]">Estoy leyendo</h3>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {currentlyReading.map((book) => (
          <a href={bookDetailUrl(book)} class="group flex min-w-0 gap-4 rounded-xl border border-[#dedcd2] bg-white/80 p-3 transition-colors hover:bg-white dark:border-[#27342b] dark:bg-[#131a15] dark:hover:bg-[#1a241e]">
            <div class="w-20 shrink-0 overflow-hidden rounded-lg bg-[#e4e7df] dark:bg-[#202a22] sm:w-24">
              {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="160" height="240" loading="lazy" decoding="async" class="aspect-[2/3] h-full w-full object-cover" /> : <div class="flex aspect-[2/3] items-center justify-center p-2 text-center text-xs text-[#636c65]">Sin portada</div>}
            </div>
            <div class="min-w-0 py-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#2d7048] dark:text-[#88c99e]">En curso</span>
              <h4 class="mt-1 font-serif text-base font-bold leading-snug text-[#17231e] group-hover:underline dark:text-[#f0f5f1]">{book.title}</h4>
              <p class="mt-1 text-xs text-[#636c65] dark:text-[#95a097]">{book.authors.join(", ")}</p>
              {book.progressPercent !== undefined && book.progressPercent > 0 && <div class="mt-3"><div class="mb-1 flex justify-between text-[10px] text-[#636c65] dark:text-[#95a097]"><span>Progreso</span><span>{book.progressPercent}%</span></div><div class="h-1.5 overflow-hidden rounded-full bg-[#dfe4da] dark:bg-[#2b3930]"><div class="h-full rounded-full bg-[#398357]" style={`width: ${Math.min(100, book.progressPercent)}%`}></div></div></div>}
              {book.startedAt && <p class="mt-2 text-[11px] text-[#636c65] dark:text-[#95a097]">Desde {formatBookDate(book.startedAt)}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {recentReads.length > 0 && (
    <section aria-labelledby="recent-reads-title" class="mb-8">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h3 id="recent-reads-title" class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f0f5f1]">Últimas lecturas</h3>
        <span class="text-xs text-[#636c65] dark:text-[#95a097]">{recentReads.length} libros terminados</span>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {recentReads.slice(0, 3).map((book) => (
          <a href={bookDetailUrl(book)} class="group min-w-0 rounded-xl border border-[#dedcd2] bg-white/70 p-3 transition-colors hover:bg-white dark:border-[#27342b] dark:bg-[#131a15] dark:hover:bg-[#1a241e]">
            <div class="mx-auto mb-3 w-full max-w-[132px] overflow-hidden rounded-lg bg-[#e4e7df] dark:bg-[#202a22]">
              {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="200" height="300" loading="lazy" decoding="async" class="aspect-[2/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" /> : <div class="flex aspect-[2/3] items-center justify-center text-xs text-[#636c65]">Sin portada</div>}
            </div>
            <h4 class="line-clamp-2 font-serif text-sm font-bold leading-snug text-[#17231e] group-hover:underline dark:text-[#f0f5f1]">{book.title}</h4>
            <p class="mt-1 line-clamp-1 text-xs text-[#636c65] dark:text-[#95a097]">{book.authors.join(", ")}</p>
            {book.completedAt && <p class="mt-2 text-[10px] text-[#636c65] dark:text-[#95a097]">Terminado {formatBookDate(book.completedAt)}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {recommendations.length > 0 && (
    <section aria-labelledby="recommendations-title">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div>
          <h3 id="recommendations-title" class="font-serif text-xl font-bold text-[#17231e] dark:text-[#f0f5f1]">En mi lista</h3>
          <p class="mt-1 text-xs text-[#636c65] dark:text-[#95a097]">Libros que quiero leer próximamente.</p>
        </div>
        <a href="/libros#recomendaciones" class="shrink-0 text-xs font-semibold text-[#48534b] hover:underline dark:text-[#88c99e]">Ver lista →</a>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-2">
        {recommendations.slice(0, 4).map((book) => (
          <a href={bookDetailUrl(book)} class="group flex w-40 shrink-0 gap-3 rounded-xl border border-[#dedcd2] bg-white/60 p-2 transition-colors hover:bg-white dark:border-[#27342b] dark:bg-[#131a15] dark:hover:bg-[#1a241e]">
            <div class="w-12 shrink-0 overflow-hidden rounded-md bg-[#e4e7df] dark:bg-[#202a22]">
              {book.image ? <img src={book.image} alt={`Portada de ${book.title}`} width="96" height="144" loading="lazy" decoding="async" class="aspect-[2/3] h-full w-full object-cover" /> : <div class="flex aspect-[2/3] items-center justify-center text-[9px] text-[#636c65]">Sin portada</div>}
            </div>
            <div class="min-w-0 py-1">
              <h4 class="line-clamp-3 text-xs font-semibold leading-snug text-[#17231e] group-hover:underline dark:text-[#f0f5f1]">{book.title}</h4>
              <p class="mt-1 line-clamp-2 text-[10px] text-[#636c65] dark:text-[#95a097]">{book.authors.join(", ")}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</section>
